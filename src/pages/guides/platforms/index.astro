---
import generated from '../../../v4/generated/example-site.json'; import V4GlobalHeader from '../../../components/v4/V4GlobalHeader.astro'; import ZadGuideCard from '../../../components/zad/ZadGuideCard.astro'; import ZadFooter from '../../../components/zad/ZadFooter.astro'; import ZadSeoHead from '../../../components/zad/ZadSeoHead.astro'; import '../../../v4/visual-system.css'; import '../../../v4/product-overrides.css';
const identity = generated.game.identity ?? {}; const style = `--v4-identity-background:url(${identity.background});--v4-bg:#f6f0e6;--v4-panel:#fffaf1;--v4-ink:#2c251e;`; const pages = generated.pages.filter((page: any) => page.href.startsWith('/guides/platforms/'));
---
<html lang="en"><head><meta charset="utf-8" /><title>Platforms - Zad Archery Help</title><link rel="canonical" href="https://zadarchery.help/guides/platforms/" /><meta name="description" content="Zad Archery platform guides for Steam Deck and mobile." /><ZadSeoHead title="Zad Archery Platform Guides - Zad Archery Help" description="Zad Archery platform guides for Steam Deck and mobile." canonical="https://zadarchery.help/guides/platforms/" /></head><body class="v4-shell zad-shell" style={style}><main class="zad-site"><V4GlobalHeader game={{...generated.game, identityAsset:'/zad-archery/12_kotaku_cover.jpg', identityLabel:'Guide site'}} navigation={generated.navigation} currentPageId="platforms" /><section class="zad-page-intro"><p class="zad-eyebrow">Guide category</p><h1>Platforms</h1><p>Compatibility and availability notes for the places you can play Zad Archery.</p></section><section class="zad-section"><div class="zad-section-heading"><div><p class="zad-eyebrow">Published answers</p><h2>Most useful first</h2></div><span>{pages.length} published guides</span></div><div class="zad-card-grid">{pages.map((page: any) => <ZadGuideCard page={page} label="Platforms" />)}</div></section><ZadFooter /></main></body></html>
