---
import generated from '../../v4/generated/example-site.json';
import categoryProgression from '../../../research/zad-archery/2026-09-02/guide-content/categories/progression.json';
import ZadArticlePage from '../../components/zad/ZadArticlePage.astro';
import V4GlobalHeader from '../../components/v4/V4GlobalHeader.astro'; import ZadGuideCard from '../../components/zad/ZadGuideCard.astro'; import ZadFooter from '../../components/zad/ZadFooter.astro'; import ZadSeoHead from '../../components/zad/ZadSeoHead.astro'; import '../../v4/visual-system.css'; import '../../v4/product-overrides.css';
const briefs: Record<string, any> = { progression: categoryProgression };
const key = Astro.params.slug?.replace(/\/$/, '') ?? ''; const brief = briefs[key]; const article = generated.pages.find((page: any) => page.href.replace(/^\/guides\//, '').replace(/\/$/, '') === key); const pages = generated.pages.filter((page: any) => page.id !== 'home' && (page.href.startsWith(`/guides/${key}/`) || (key === 'progression' && page.href === '/guides/getting-started/')));
export function getStaticPaths() { const categorySlugs = ['progression']; return [...categorySlugs.map((slug) => ({ params: { slug }, props: { slug } })), ...generated.pages.filter((page: any) => page.href.startsWith('/guides/')).map((page: any) => ({ params: { slug: page.href.replace(/^\/guides\//, '').replace(/\/$/, '') }, props: { slug: page.href.replace(/^\/guides\//, '').replace(/\/$/, '') } }))]; }
const identity = generated.game.identity ?? {}; const style = `--v4-identity-background:url(${identity.background});--v4-bg:#f6f0e6;--v4-panel:#fffaf1;--v4-ink:#2c251e;`;
---
{article ? <ZadArticlePage page={article} /> : <html lang="en"><head><meta charset="utf-8" /><title>{brief?.title ?? 'Guide category'} - Zad Archery Help</title><link rel="canonical" href="https://zadarchery.help/guides/progression/" /><meta name="description" content={brief?.description_draft} /><ZadSeoHead title="Zad Archery Progression Guides - Zad Archery Help" description="Browse published Zad Archery progression guides." canonical="https://zadarchery.help/guides/progression/" /></head><body class="v4-shell zad-shell" style={style}><main class="zad-site"><V4GlobalHeader game={{...generated.game, identityAsset:'/zad-archery/12_kotaku_cover.jpg', identityLabel:'Guide site'}} navigation={generated.navigation} currentPageId={key} /><section class="zad-page-intro"><p class="zad-eyebrow">Guide category</p><h1>{brief?.title}</h1><p>{brief?.description_draft}</p></section><section class="zad-section zad-category-layout"><div><div class="zad-section-heading"><div><p class="zad-eyebrow">Published answers</p><h2>Most useful first</h2></div><span>{pages.length} published {pages.length === 1 ? 'guide' : 'guides'}</span></div><div class="zad-card-grid">{pages.map((page: any) => <ZadGuideCard page={page} label={brief.title} />)}</div></div><aside class="zad-questions-panel"><p class="zad-eyebrow">Player questions</p><h2>What players ask</h2>{(brief?.player_questions ?? []).map((question: string) => <a href={`/search/?q=${encodeURIComponent(question)}`}>{question}<span>↗</span></a>)}</aside></section><ZadFooter /></main></body></html>}
