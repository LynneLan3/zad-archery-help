---
import generated from '../../v4/generated/example-site.json'; import V4GlobalHeader from '../../components/v4/V4GlobalHeader.astro'; import ZadGuideCard from '../../components/zad/ZadGuideCard.astro'; import ZadFooter from '../../components/zad/ZadFooter.astro'; import ZadSeoHead from '../../components/zad/ZadSeoHead.astro'; import '../../v4/visual-system.css'; import '../../v4/product-overrides.css';
const identity = generated.game.identity ?? {}; const style = `--v4-identity-background:url(${identity.background});--v4-bg:#f6f0e6;--v4-panel:#fffaf1;--v4-ink:#2c251e;`; const pages = generated.pages.filter((page: any) => page.href.startsWith('/updates/'));
---
<html lang="en"><head><meta charset="utf-8" /><title>Updates - Zad Archery Help</title><link rel="canonical" href="https://zadarchery.help/updates/" /><meta name="description" content="Zad Archery patch notes and launch updates." /><ZadSeoHead title="Zad Archery Updates - Zad Archery Help" description="Zad Archery patch notes and launch updates." canonical="https://zadarchery.help/updates/" /></head><body class="v4-shell zad-shell" style={style}><main class="zad-site"><V4GlobalHeader game={{...generated.game, identityAsset:'/zad-archery/12_kotaku_cover.jpg', identityLabel:'Guide site'}} navigation={generated.navigation} currentPageId="updates" /><section class="zad-page-intro"><p class="zad-eyebrow">Patch notes</p><h1>Updates</h1><p>Current changes that matter when you return to Zad Archery.</p></section><section class="zad-section"><div class="zad-card-grid">{pages.map((page: any) => <ZadGuideCard page={page} label="Update" />)}</div></section><ZadFooter /></main></body></html>
