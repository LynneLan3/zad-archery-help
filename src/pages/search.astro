---
import generated from '../v4/generated/example-site.json'; import V4GlobalHeader from '../components/v4/V4GlobalHeader.astro'; import ZadFooter from '../components/zad/ZadFooter.astro'; import ZadSeoHead from '../components/zad/ZadSeoHead.astro'; import '../v4/visual-system.css'; import '../v4/product-overrides.css';
const identity = generated.game.identity ?? {}; const style = `--v4-identity-background:url(${identity.background});--v4-bg:#f6f0e6;--v4-panel:#fffaf1;--v4-ink:#2c251e;`; const pages = generated.pages.filter((page: any) => page.id !== 'home');
---
<html lang="en"><head><meta charset="utf-8" /><title>Search - Zad Archery Help</title><link rel="canonical" href="https://zadarchery.help/search/" /><meta name="description" content="Search verified Zad Archery guides." /><ZadSeoHead title="Search Zad Archery Guides - Zad Archery Help" description="Search verified Zad Archery guides." canonical="https://zadarchery.help/search/" /></head><body class="v4-shell zad-shell" style={style}><main class="zad-site" data-zad-search><V4GlobalHeader game={{...generated.game, identityAsset:'/zad-archery/12_kotaku_cover.jpg', identityLabel:'Guide site'}} navigation={generated.navigation} currentPageId="search" /><section class="zad-page-intro"><p class="zad-eyebrow">Search</p><h1>What are you looking for?</h1><p>Find the fastest answer across the published Zad Archery guide library.</p><form class="zad-library-search" role="search"><label class="sr-only" for="site-search">Search Zad Archery guides</label><input id="site-search" name="q" type="search" placeholder="Search Zad Archery guides…" /><button type="submit">Search</button></form></section><section class="zad-section"><p class="zad-search-status" aria-live="polite">{pages.length} published guides</p><div class="zad-search-results">{pages.map((page: any) => <a class="zad-search-result" href={page.href} data-search={`${page.title} ${page.pageData.page.playerProblem} ${page.pageData.body.intro} ${page.pageData.body.sections.map((section: any) => `${section.title} ${section.paragraphs.join(' ')}`).join(' ')}`}><span class="zad-label">Guide</span><strong>{page.title}</strong><small>{page.pageData.page.playerProblem}</small></a>)}</div><p class="zad-empty" hidden>No matching guides yet. Try a broader question.</p></section><ZadFooter /></main></body><script is:inline>const root=document.querySelector('[data-zad-search]');const input=document.querySelector('#site-search');const items=[...document.querySelectorAll('.zad-search-result')];const empty=document.querySelector('.zad-empty');const status=document.querySelector('.zad-search-status');const run=()=>{const q=new URLSearchParams(location.search).get('q')||input.value;input.value=q;const tokens=q.toLowerCase().split(/\s+/).filter(Boolean);let count=0;items.forEach(item=>{const text=(item.dataset.search||'').toLowerCase();const show=!tokens.length||tokens.every(token=>text.includes(token));item.hidden=!show;if(show)count++});empty.hidden=count>0;status.textContent=`${count} guide${count===1?'':'s'}${q?' for “'+q+'”':''}`};root.querySelector('form').addEventListener('submit',(event)=>{event.preventDefault();const q=input.value.trim();history.replaceState({},'',q?`/search/?q=${encodeURIComponent(q)}`:'/search/');run()});input.addEventListener('input',run);run();</script></html>
