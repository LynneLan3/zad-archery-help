---
import generated from '../v4/generated/example-site.json';
import V4GlobalHeader from '../components/v4/V4GlobalHeader.astro';
import ZadGuideCard from '../components/zad/ZadGuideCard.astro';
import ZadFooter from '../components/zad/ZadFooter.astro';
import ZadSeoHead from '../components/zad/ZadSeoHead.astro';
import '../v4/visual-system.css'; import '../v4/product-overrides.css';
const identity = generated.game.identity ?? {}; const style = `--v4-identity-background:url(${identity.background});--v4-bg:#f6f0e6;--v4-panel:#fffaf1;--v4-ink:#2c251e;`;
const pages = generated.pages.filter((page: any) => page.id !== 'home');
---
<html lang="en"><head><meta charset="utf-8" /><title>Guides - Zad Archery Help</title><link rel="canonical" href="https://zadarchery.help/guides/" /><meta name="description" content="Browse verified Zad Archery guides for progression, platforms, achievements and updates." /><ZadSeoHead title="Zad Archery Guide Library - Zad Archery Help" description="Browse verified Zad Archery guides for progression, platforms, achievements and updates." canonical="https://zadarchery.help/guides/" /></head><body class="v4-shell zad-shell" style={style}><main class="zad-site"><V4GlobalHeader game={{...generated.game, identityAsset:'/zad-archery/12_kotaku_cover.jpg', identityLabel:'Guide site'}} navigation={generated.navigation} currentPageId="guides" /><section class="zad-page-intro"><p class="zad-eyebrow">The guide library</p><h1>Find the answer you need.</h1><p>Search-first guides for the questions players actually ask at launch. Use the filters to narrow the library.</p><form class="zad-library-search" action="/search/" role="search"><label class="sr-only" for="guides-search">Search the Zad Archery guide library</label><input id="guides-search" name="q" type="search" placeholder="Search the guide library…" /><button type="submit">Search</button></form></section><section class="zad-section"><div class="zad-filter-row"><span>All guides</span><span>{pages.length} published guides</span><a href="/guides/progression/">Progression</a><a href="/guides/platforms/">Platforms</a><a href="/achievements/">Achievements</a></div><div class="zad-card-grid zad-card-grid-wide">{pages.map((page: any) => <ZadGuideCard page={page} label={page.pageData?.page?.href?.startsWith('/updates') ? 'Updates' : page.pageData?.page?.playerProblem?.includes('platform') ? 'Platforms' : page.id === 'achievements' ? 'Achievements' : 'Guide'} />)}</div></section><ZadFooter /></main></body></html>
