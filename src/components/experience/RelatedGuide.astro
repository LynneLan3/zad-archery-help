---
import type { GuideEntry } from '../../lib/guides';
import { guideHref } from '../../lib/guides';
import { resolveGuideCardImage, guideCardImageAlt } from '../../lib/card-images';
import CardThumbnail from '../CardThumbnail.astro';
interface Props { entry: GuideEntry; relationship?: string }
const { entry, relationship = 'Related guide' } = Astro.props;
const image = resolveGuideCardImage(entry);
---
<a class="exp-related-guide" href={guideHref(entry)}>
	{image && <CardThumbnail class="exp-related-guide__media" image={image} alt={guideCardImageAlt(entry)} width={160} />}
	<span><small>{relationship}</small><strong>{entry.data.title}</strong><span>{entry.data.description}</span></span>
</a>
