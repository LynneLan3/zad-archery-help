---
import type { GuideEntry } from '../../lib/guides';
import GuideGridV3 from './GuideGridV3.astro';
const { entries, title, description } = Astro.props as { entries: GuideEntry[]; title: string; description: string };
---
<section class="v3-section"><span class="v3-eyebrow">Field guide</span><h1>{title}</h1><p>{description}</p></section><section class="v3-section"><h2>All Guides</h2><GuideGridV3 entries={entries} /></section>
