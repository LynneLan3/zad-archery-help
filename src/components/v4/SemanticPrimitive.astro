---
// @ts-nocheck
const { primitive, page, gameName } = Astro.props;
const p = primitive.payload ?? {};
const evidence = new Map((page.pageData.evidence ?? []).map((item) => [item.evidenceId, item]));
const media = new Map((page.pageData.media ?? []).map((item) => [item.mediaId, item]));
const refs = primitive.evidenceRefs?.map((id) => evidence.get(id)).filter(Boolean) ?? [];
const mediaRefs = primitive.mediaRefs?.map((id) => media.get(id)).filter(Boolean) ?? [];
const functionalMediaRefs = mediaRefs.filter((item) => item.role !== 'decorative');
const decorativeMediaRefs = mediaRefs.filter((item) => item.role === 'decorative');
const findCell = (optionId, dimensionId) => p.cells?.find((item) => item.optionId === optionId && item.dimensionId === dimensionId);
const titleByPrimitive = { E01: 'Quick facts', E02: 'Collection', P01: 'What you need', P02: 'Steps', P03: 'Milestones', P04: 'When it fails', L03: 'Route', E03: 'Available gear', D01: 'Compare options', D02: 'Current ranking', D03: 'Choose by situation', X03: 'Formula', X04: 'Calculator', X05: 'Current build' };
const title = titleByPrimitive[primitive.id] ?? '';
---
{primitive.id === 'A01' && <header class="v4-answer-header"><p class="v4-kicker">{gameName} guide{p.subject && ` / ${p.subject}`}</p><h1>{page.title}</h1><p class="v4-muted">{page.pageData.intent.playerProblem}</p>{mediaRefs.map((item) => <figure class="v4-identity-media"><img src={item.localRef ?? item.source} alt={item.alt} width={item.width ?? 720} height={item.height ?? 420} />{item.caption && <figcaption>{item.caption}</figcaption>}</figure>)}</header>}
{primitive.id === 'A02' && <aside class="v4-quick-answer"><span class="v4-kicker">Quick answer</span><strong>{p.answer}</strong>{p.qualifier && <small>{p.qualifier}</small>}{refs.length > 0 && <small class="v4-evidence">{refs[0].finding}</small>}{p.nextAction && <a href={p.nextAction.href ?? p.nextAction}>Continue</a>}</aside>}
{primitive.id === 'A03' && <><aside class="v4-context"><strong>{p.scope}</strong>{p.caveat && <span>{p.caveat}</span>}{p.conditions?.map((item) => <span>{item}</span>)}</aside>{functionalMediaRefs.length > 0 && <div class="v4-inline-media v4-evidence-media" aria-label="Functional evidence media">{functionalMediaRefs.map((item) => <figure><img src={item.localRef ?? item.source} alt={item.alt} width={item.width ?? 720} height={item.height ?? 420} />{item.caption && <figcaption>{item.caption}</figcaption>}{item.provenance && <small>{item.provenance}</small>}</figure>)}</div>}{decorativeMediaRefs.length > 0 && <div class="v4-decorative-media" aria-label="Decorative media">{decorativeMediaRefs.map((item) => <img src={item.localRef ?? item.source} alt="" aria-hidden="true" />)}</div>}</>}
{primitive.id === 'S01' && <div class="v4-state"><span>{p.label || 'Version'}</span><strong>{p.value}</strong>{p.applicability && <small>{p.applicability}</small>}{refs.length > 0 && <small class="v4-evidence">{refs[0].finding}</small>}</div>}
{primitive.id === 'S02' && <div class="v4-state v4-platform-state"><span>{p.label || 'Platform'}</span><strong>{p.value}</strong>{p.applicability && <small>{p.applicability}</small>}{refs.length > 0 && <small class="v4-evidence">{refs[0].finding}</small>}{p.options?.map((option) => <button type="button" data-v4-platform={option}>{option}</button>)}</div>}
{primitive.id === 'S03' && <section class:list={['v4-season', p.events?.length && 'v4-calendar']}><div class="v4-state"><span>{p.label || 'Season'}</span><strong>{p.value}</strong>{p.currentDay && <small>Current: {p.currentDay}</small>}{p.applicability && <small>{p.applicability}</small>}</div>{p.options?.length && <div class="v4-state-options">{p.options.map((option) => <button type="button" data-v4-season={option}>{option}</button>)}</div>}{p.events?.length && <div class="v4-calendar-grid" aria-label="Cycle calendar">{p.events.map((event) => <article class:list={[event.current && 'is-current', event.deadline && 'is-deadline']}><time>{event.date}{event.current && ' - Current'}{event.deadline && ' - Deadline'}</time><strong>{event.title}</strong>{event.detail && <span>{event.detail}</span>}{event.availability && <small>Availability: {event.availability}</small>}{event.economics && <small>Economics: {event.economics}</small>}</article>)}</div>}</section>}
{primitive.id === 'S04' && <p class="v4-freshness">Updated: {p.value}</p>}
{primitive.id === 'E01' && <section class="v4-facts">{title && <h2>{title}</h2>}<dl>{p.facts?.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}{fact.state && <small>{fact.state}</small>}</dd></div>)}</dl></section>}
{primitive.id === 'E02' && <section class="v4-entity-grid"><div class="v4-grid-heading"><div><span class="v4-kicker">{p.group || 'Browse'}</span><h2>{title}</h2></div><span>{p.entities ? p.entities.length : 0} entries</span></div><div class="v4-entities">{p.entities && p.entities.map((entity) => <a href={entity.href || '#'}><span><strong>{entity.name}</strong>{entity.summary && <small>{entity.summary}</small>}{entity.meta && <small class="v4-meta">{entity.meta}</small>}</span></a>)}</div></section>}
{primitive.id === 'E03' && <section class="v4-table-wrap"><h2>{title}</h2><table><caption class="sr-only">Available gear</caption><thead><tr>{p.columns?.map((column) => <th scope="col">{column.label}</th>)}</tr></thead><tbody data-v4-sort-results>{p.rows?.map((row) => <tr>{p.columns?.map((column) => <td>{String(row[column.id] ?? '')}</td>)}</tr>)}</tbody></table>{refs.length > 0 && <small class="v4-source-note">{refs[0].finding}</small>}</section>}
{primitive.id === 'D01' && <section class="v4-comparison"><h2>{title}</h2><div class="v4-comparison-table"><div class="v4-comparison-head"><span>Dimension</span>{p.options?.map((option) => <strong>{option.label}</strong>)}</div>{p.dimensions?.map((dimension) => <div class="v4-comparison-row"><strong>{dimension.label}</strong>{p.options?.map((option) => <span>{findCell(option.id, dimension.id)?.value || '-'}{findCell(option.id, dimension.id)?.note && <small>{findCell(option.id, dimension.id).note}</small>}</span>)}</div>)}</div><div class="v4-comparison-mobile">{p.options?.map((option) => <article><h3>{option.label}</h3>{p.dimensions?.map((dimension) => <p><strong>{dimension.label}:</strong> {findCell(option.id, dimension.id)?.value || '-'}</p>)}</article>)}</div>{p.recommendation && <p class="v4-recommendation"><strong>Conditional recommendation: {p.options?.find((option) => option.id === p.recommendation.optionId)?.label}</strong><span>{p.recommendation.reason}</span></p>}</section>}
{primitive.id === 'D02' && <section class="v4-ranking"><h2>{title}</h2><ol>{p.entries?.map((entry) => <li><b>{entry.rank}</b><span><strong>{entry.choice}</strong>{entry.state && <small>{entry.state}</small>}<span>{entry.reason}</span></span></li>)}</ol>{p.methodology && <small class="v4-source-note">Method: {p.methodology}</small>}</section>}
{primitive.id === 'D03' && <section class="v4-choice-matrix"><h2>{title}</h2>{p.scenarios?.map((scenario) => <article><span>{scenario.condition}</span><strong>{scenario.choice}</strong><p>{scenario.reason}</p></article>)}</section>}
{primitive.id === 'P01' && <section class="v4-requirements"><h2>{title}</h2><ul>{p.requirements?.map((item) => <li><span class="v4-check" data-status={item.status} aria-hidden="true"></span><span><strong>{item.label}</strong>{item.howToMeet && <small>{item.howToMeet}</small>}</span></li>)}</ul></section>}
{primitive.id === 'P02' && <section class="v4-steps"><h2>{title}</h2><ol>{p.steps?.map((step) => <li><div><strong>{step.action}</strong>{step.result && <p>{step.result}</p>}{step.mediaRefs?.map((id) => media.get(id) && <figure class="v4-step-media"><img src={media.get(id).localRef ?? media.get(id).source} alt={media.get(id).alt} width={media.get(id).width ?? 720} height={media.get(id).height ?? 420} />{media.get(id).caption && <figcaption>{media.get(id).caption}</figcaption>}</figure>)}</div>{step.evidenceRefs?.map((id) => evidence.get(id) && <small class="v4-evidence">{evidence.get(id).finding}</small>)}</li>)}</ol></section>}
{primitive.id === 'P03' && <section class="v4-progress"><h2>{title}</h2><ol>{p.milestones?.map((milestone) => <li data-status={milestone.status}><span class="v4-progress-node" aria-hidden="true"></span><div><strong>{milestone.label}</strong>{milestone.status && <small>{milestone.status}</small>}{milestone.next && <p>Next: {milestone.next}</p>}</div></li>)}</ol></section>}
{primitive.id === 'P04' && <section class="v4-recovery"><h2>{title}</h2>{p.cases?.map((item) => <div><strong>{item.symptom}</strong>{item.cause && <span>Cause: {item.cause}</span>}<p>{item.recovery}</p></div>)}</section>}
{primitive.id === 'L01' && <section class="v4-location"><dl>{p.area && <div><dt>Area</dt><dd>{p.area}</dd></div>}{p.coordinates && <div><dt>Coordinates</dt><dd>{p.coordinates.x}, {p.coordinates.y}{p.coordinates.region && ` / ${p.coordinates.region}`}</dd></div>}{p.landmark && <div><dt>Landmark</dt><dd>{p.landmark}</dd></div>}{p.access && <div><dt>Access</dt><dd>{p.access}</dd></div>}</dl></section>}
{primitive.id === 'L02' && <section class="v4-map"><div class="v4-map-heading"><div><span class="v4-kicker">Where to look</span><h2>Map</h2></div><span>{p.source}</span></div>{mediaRefs.map((item) => <figure><img src={item.localRef ?? item.source} alt={item.alt} width={item.width ?? 1200} height={item.height ?? 640} />{item.caption && <figcaption>{item.caption}</figcaption>}</figure>)}<div class="v4-map-markers" data-v4-map>{p.markers?.map((marker, index) => <button type="button" data-v4-map-marker={index} data-label={marker.label}>{marker.label}</button>)}</div><p data-v4-map-result>Choose a marker to see its location.</p>{refs.length > 0 && <small class="v4-source-note">{refs[0].finding}</small>}</section>}
{primitive.id === 'L03' && <section class="v4-route"><h2>{title}</h2><ol><li>{p.start}</li>{p.waypoints?.map((point) => <li><strong>{point.label}</strong>{point.instruction && <span>{point.instruction}</span>}</li>)}<li>{p.destination}</li></ol></section>}
{primitive.id === 'X01' && <section class="v4-filter"><label for={`filter-${primitive.instanceId}`}>Filter results<input id={`filter-${primitive.instanceId}`} data-v4-filter type="search" placeholder="Search the armory" /></label><output data-v4-filter-count></output></section>}
{primitive.id === 'X02' && <section class="v4-sort"><label for={`sort-${primitive.instanceId}`}>Sort items<select id={`sort-${primitive.instanceId}`} data-v4-sort><option value="name">Name</option><option value="power">Power</option></select></label></section>}
{primitive.id === 'X03' && <section class="v4-formula"><h2>{title}</h2><p class="v4-expression">{p.expression}</p><dl>{p.variables?.map((item) => <div><dt>{item.name}</dt><dd>{item.meaning}{item.unit && ` / ${item.unit}`}</dd></div>)}</dl>{p.workedExample && <div class="v4-example"><strong>Worked example</strong>{Object.entries(p.workedExample.inputs).map(([key,value]) => <span>{key}: {String(value)}</span>)}<b>Result: {p.workedExample.result}</b></div>}{refs.length > 0 && <small class="v4-source-note">{refs[0].finding}</small>}</section>}
{primitive.id === 'X04' && <section class="v4-calculator"><h2>{title}</h2>{p.inputs?.map((item) => <label>{item.label}{item.unit && <small>({item.unit})</small>}<input data-v4-calc-input={item.id} type="number" value={item.value ?? 1} /></label>)}<p class="v4-result">Result: <output data-v4-calc-result>{p.result?.value}</output></p><small data-v4-calc-interpretation>{p.result?.interpretation}</small></section>}
{primitive.id === 'X05' && <section class="v4-workspace"><div><span class="v4-kicker">Build state</span><h2>{title}</h2></div><div class="v4-workspace-controls">{p.controls?.map((control) => <button type="button" data-v4-workspace-control={control.id}>{control.label}</button>)}<button type="button" data-v4-save>Save locally</button><button type="button" data-v4-share>Copy share state</button></div><output data-v4-workspace-result>{p.result ?? 'No selections yet.'}</output><small data-v4-save-state></small></section>}
{primitive.id === 'N01' && <nav class="v4-next" aria-label="Related next step"><span class="v4-kicker">Next task</span>{p.steps?.map((step) => <a href={step.href}><strong>{step.label}</strong><small>{step.reason}</small></a>)}</nav>}
