---
import { game } from '../config/game';
import { resolveAnalyticsEnvironment, shouldLoadGa4 } from '../lib/analytics';
import VercelAnalytics from './VercelAnalytics.astro';

const analytics = game.analytics;
const environment = resolveAnalyticsEnvironment({
	isProd: import.meta.env.PROD,
	vercelEnv: import.meta.env.VERCEL_ENV,
});
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim();
const ga4Enabled = Boolean(analytics?.ga4?.enabled || analytics?.provider === 'ga4');
const hasIdentity = Boolean(analytics?.siteId && analytics?.gameSlug && analytics?.templateVersion);
const enabled = shouldLoadGa4({
	analyticsEnabled: Boolean(analytics?.enabled),
	ga4Enabled,
	measurementId,
	environment,
});
const siteHost = enabled ? new URL(game.siteUrl).hostname : '';
const config =
		enabled && analytics
		? {
				measurementId,
				siteHost,
				trackOutbound: analytics.trackOutbound,
				siteId: analytics.siteId,
				gameSlug: analytics.gameSlug,
				templateVersion: analytics.templateVersion,
			}
		: null;
---

{
	config && (
		<script type="application/json" id="gw-analytics-config" set:html={JSON.stringify(config)} />
	)
}

{
	config && ga4Enabled && (
		<script is:inline define:vars={{ measurementId: config.measurementId, siteHost: config.siteHost }}>
			(function () {
				try {
					if (location.hostname !== siteHost) return;
				} catch (error) {
					return;
				}
				window.dataLayer = window.dataLayer || [];
				window.gtag =
					window.gtag ||
					function () {
						window.dataLayer.push(arguments);
					};
				if (!document.querySelector('script[data-gw-ga4-bootstrap]')) {
					var script = document.createElement('script');
					script.async = true;
					script.dataset.gwGa4Bootstrap = 'true';
					script.src = 'https://www.googletagmanager.com/gtag/js?id=' + measurementId;
					document.head.appendChild(script);
				}
				window.gtag('js', new Date());
				window.gtag('config', measurementId);
			})();
		</script>
	)
}

{
	config?.trackOutbound && (
		<script>
			import { attachOutboundTracking } from '../lib/outbound';
			attachOutboundTracking();
		</script>
	)
}

<VercelAnalytics />

{
	config && hasIdentity && (
		<script>
			import { attachCoreInteractionTracking } from '../lib/analytics-events';
			attachCoreInteractionTracking();
		</script>
	)
}
