---
import generated from '../../v4/generated/example-site.json'; import V4GlobalHeader from '../v4/V4GlobalHeader.astro'; import V4Breadcrumb from '../v4/V4Breadcrumb.astro'; import SemanticPrimitive from '../v4/SemanticPrimitive.astro'; import PageBody from '../v4/PageBody.astro'; import ZadGuideCard from './ZadGuideCard.astro'; import ZadFooter from './ZadFooter.astro'; import ZadSeoHead from './ZadSeoHead.astro'; import ZadQuickAnswer from './ZadQuickAnswer.astro';
import '../../v4/visual-system.css';
import '../../v4/product-overrides.css';
const { page } = Astro.props as { page: any }; const pages = generated.pages.filter((item: any) => item.id !== 'home'); const index = pages.findIndex((item: any) => item.id === page.id); const previous = pages[index - 1]; const next = pages[index + 1]; const related = pages.filter((item: any) => item.id !== page.id && item.pageData?.page?.playerProblem?.split(' ')[0] === page.pageData?.page?.playerProblem?.split(' ')[0]).slice(0, 3); const identity = generated.game.identity ?? {}; const style = `--v4-identity-background:url(${identity.background});--v4-bg:#f6f0e6;--v4-panel:#fffaf1;--v4-ink:#2c251e;`; const lead = page.composition.primitives.filter((item: any) => ['A01'].includes(item.id));
---
<html lang="en"><head><meta charset="utf-8" /><title>{page.title} - Zad Archery Help</title><meta name="description" content={page.pageData.body.intro} /><link rel="canonical" href={`https://zadarchery.help${page.href}`} /><ZadSeoHead title={`${page.title} - Zad Archery Help`} description={page.pageData.body.intro} canonical={`https://zadarchery.help${page.href}`} article /></head><body class="v4-shell zad-shell" style={style}><main class="zad-site"><V4GlobalHeader game={{...generated.game, identityAsset:'/zad-archery/12_kotaku_cover.jpg', identityLabel:'Guide site'}} navigation={generated.navigation} currentPageId={page.id} /><V4Breadcrumb navigation={generated.navigation} pageId={page.id} gameName="Zad Archery" /><article class="zad-article"><div class="zad-article-main"><div class="zad-article-lead">{lead.map((primitive: any) => <SemanticPrimitive primitive={primitive} page={page} gameName="Zad Archery" />)}<div class="zad-article-meta"><span>{page.pageData.page.playerProblem}</span><span>Updated {page.pageData.freshness?.dataWindow ?? 'at launch'}</span></div></div><ZadQuickAnswer text={page.pageData.body.intro} /><PageBody body={page.pageData.body} includeIntro={false} includeFaq={true} /><div class="zad-related-questions"><p class="zad-eyebrow">Related questions</p><a href={`/search/?q=${encodeURIComponent(page.pageData.page.query)}`}>Search more about {page.pageData.page.query} <span>↗</span></a></div>{related.length > 0 && <section class="zad-related"><p class="zad-eyebrow">Keep reading</p><h2>Related guides</h2><div class="zad-card-grid">{related.map((item: any) => <ZadGuideCard page={item} label="Related guide" />)}</div></section>}<nav class="zad-prev-next" aria-label="Previous and next article">{previous && <a href={previous.href}><small>Previous guide</small><strong>← {previous.title}</strong></a>}{next && <a href={next.href}><small>Next guide</small><strong>{next.title} →</strong></a>}</nav></div><aside class="zad-article-toc"><strong>On this page</strong>{page.pageData.body.sections.map((section: any, i: number) => section.title && <a href={`#section-${i + 1}`}>{section.title}</a>)}{page.pageData.body.faq.length > 0 && <a href="#faq">FAQ</a>}</aside></article><ZadFooter /></main></body></html>
