---
import SemanticPrimitive from '../components/v4/SemanticPrimitive.astro';
import generated from '../v4/generated/example-site.json';
import '../v4/visual-system.css';
import '../v4/product-overrides.css';
import V4GlobalHeader from '../components/v4/V4GlobalHeader.astro';
import V4Breadcrumb from '../components/v4/V4Breadcrumb.astro';
import V4ThemeStyle from '../components/v4/V4ThemeStyle.astro';
import PageBody from '../components/v4/PageBody.astro';
export function getStaticPaths() { return generated.pages.map((page) => ({ params: { page: page.id }, props: { page } })); }
const page = Astro.props.page as { id: string; title: string; pageData: { body?: any; intent: { prototype: string } }; composition: { primitives: readonly { id: string }[] } };
const primitives = page.composition.primitives;
const tocTitles: Record<string, string> = { E01: 'Quick facts', E02: 'Collection', E03: 'Available gear', P01: 'What you need', P02: 'Steps', P03: 'Milestones', P04: 'When it fails', L01: 'Location', L02: 'Map', L03: 'Route', D01: 'Compare options', D02: 'Current ranking', D03: 'Choose by situation', X01: 'Filter results', X02: 'Sort items', X03: 'Formula', X04: 'Calculator', X05: 'Current build' };
const toc = primitives.filter((primitive) => tocTitles[primitive.id]);
const leadByPrototype: Record<string, string[]> = { P1: ['A01', 'A02'], P4: ['A01', 'P01', 'P02'], P5: ['A01', 'L01', 'L02'], P6: ['A01', 'A02', 'P03'], P7: ['A01', 'A03', 'X03', 'X04'], P9: ['A01', 'X05'] };
const leadIds = new Set(leadByPrototype[page.pageData.intent.prototype] ?? ['A01', 'A02']);
const leadPrimitives = primitives.filter((primitive) => leadIds.has(primitive.id));
const supportingPrimitives = primitives.filter((primitive) => !leadIds.has(primitive.id) && primitive.id !== 'N01');
const nextPrimitive = primitives.find((primitive) => primitive.id === 'N01');
---
<V4ThemeStyle theme={generated.theme} />
<html lang="en"><head><title>{page.title} / {generated.game.name}</title></head><body class="v4-shell"><main class:list={['v4-answer', page.pageData.intent.prototype === 'P9' && 'v4-utility-page']} data-v4-page={page.id}><V4GlobalHeader game={generated.game} navigation={generated.navigation} currentPageId={page.id} /><V4Breadcrumb navigation={generated.navigation} pageId={page.id} gameName={generated.game.name} />{toc.length >= 4 && <nav class="v4-toc" aria-label="On this page"><span class="v4-kicker">On this page</span>{toc.map((primitive, index) => <a href={`#v4-section-${index}`}>{tocTitles[primitive.id]}</a>)}</nav>}<div class="v4-page-flow">{leadPrimitives.map((primitive) => <SemanticPrimitive primitive={primitive} page={page} gameName={generated.game.name} />)}<PageBody body={page.pageData.body} includeFaq={false} />{supportingPrimitives.map((primitive) => <SemanticPrimitive primitive={primitive} page={page} gameName={generated.game.name} />)}<PageBody body={page.pageData.body} onlyFaq={true} />{nextPrimitive && <SemanticPrimitive primitive={nextPrimitive} page={page} gameName={generated.game.name} />}</div></main></body><script is:inline>
const root = document.querySelector('[data-v4-page]');
document.querySelectorAll('.v4-page-flow h2').forEach((heading, index) => { heading.id = `v4-section-${index}`; });
const resultRows = () => root?.querySelectorAll('[data-v4-sort-results] tr') ?? [];
document.querySelectorAll('[data-v4-filter]').forEach((input) => input.addEventListener('input', () => { const query = input.value.toLowerCase(); let visible = 0; resultRows().forEach((row) => { const shown = row.textContent.toLowerCase().includes(query); row.hidden = !shown; if (shown) visible += 1; }); const count = input.closest('.v4-filter')?.querySelector('[data-v4-filter-count]'); if (count) count.textContent = `${visible} result${visible === 1 ? '' : 's'}`; }));
document.querySelectorAll('[data-v4-sort]').forEach((select) => select.addEventListener('change', () => { const body = root?.querySelector('[data-v4-sort-results]'); if (!body) return; const rows = [...body.querySelectorAll('tr')]; const column = select.value === 'power' ? 2 : 0; rows.sort((a,b) => { const av=a.children[column]?.textContent ?? ''; const bv=b.children[column]?.textContent ?? ''; return select.value === 'power' ? Number(bv)-Number(av) : av.localeCompare(bv); }).forEach((row) => body.append(row)); }));
document.querySelectorAll('[data-v4-map-marker]').forEach((button) => button.addEventListener('click', () => { const map=button.closest('.v4-map'); const result=map?.querySelector('[data-v4-map-result]'); if(result) result.textContent=`Selected: ${button.dataset.label}`; map?.querySelectorAll('[data-v4-map-marker]').forEach((item)=>item.removeAttribute('aria-current')); button.setAttribute('aria-current','true'); }));
const calculate=()=>{const values=Object.fromEntries([...document.querySelectorAll('[data-v4-calc-input]')].map((input)=>[input.dataset.v4CalcInput,Number(input.value||0)])); const output=document.querySelector('[data-v4-calc-result]'); if(output) output.textContent=String(values.base+values.duration*values.rate);}; document.querySelectorAll('[data-v4-calc-input]').forEach((input)=>input.addEventListener('input',calculate));
const workspace={slots:(localStorage.getItem('v4-workspace')||'').split(',').filter(Boolean)}; const updateWorkspace=()=>{const output=document.querySelector('[data-v4-workspace-result]'); if(output) output.textContent=workspace.slots.length?`Selected tools: ${workspace.slots.join(', ')}`:'Choose a tool to begin.';}; document.querySelectorAll('[data-v4-workspace-control]').forEach((button)=>button.addEventListener('click',()=>{const value=button.dataset.v4WorkspaceControl; workspace.slots=workspace.slots.includes(value)?workspace.slots.filter((item)=>item!==value):[...workspace.slots,value]; updateWorkspace();})); document.querySelectorAll('[data-v4-save]').forEach((button)=>button.addEventListener('click',()=>{localStorage.setItem('v4-workspace',workspace.slots.join(',')); const state=document.querySelector('[data-v4-save-state]'); if(state) state.textContent='Saved on this device.';})); document.querySelectorAll('[data-v4-share]').forEach((button)=>button.addEventListener('click',async()=>{const value=`${location.origin}${location.pathname}?slots=${encodeURIComponent(workspace.slots.join(','))}`; try{await navigator.clipboard.writeText(value);}catch{} const state=document.querySelector('[data-v4-save-state]'); if(state) state.textContent='Share URL copied.';})); updateWorkspace();
</script></html>
